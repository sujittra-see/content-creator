---
import type { ExperienceEntry } from '../data/types';
import ResponsiveImage from './ResponsiveImage.astro';
import { sanitizeHttpsUrl } from '../utils/url';

interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props;
const { title, role, category, dateRange, tags, tools, metrics, image, figmaEmbedUrl, externalUrl } = entry;
const safeExternalUrl = sanitizeHttpsUrl(externalUrl);
---

<article class="group flex h-full flex-col overflow-hidden border-t border-primary/15 pt-4 transition-[transform] duration-200 ease-out hover:-translate-y-1">
  {image && (
  <figure class="relative overflow-hidden rounded-2xl border border-primary/10 bg-[var(--surface)] shadow-[var(--shadow-soft)]">
    <ResponsiveImage
      src={image}
      alt={`${title} - ${role}`}
      class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.035]"
      width={400}
      height={300}
      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
    />
    <span class="absolute left-3 top-3 rounded-full border border-background/60 bg-background/84 px-3 py-1 text-xs font-semibold text-primary shadow-[0_12px_30px_-20px_rgba(39,33,28,0.8)] backdrop-blur-sm">
      {category === 'professional' ? 'Professional' : 'Academic'}
    </span>
  </figure>
  )}

  <div class="flex flex-1 flex-col gap-3 px-1 pt-5">
    <div class="flex flex-col gap-1">
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">{dateRange}</span>
      <span class="text-sm font-semibold text-text-muted">{role}</span>
    </div>

    <h3 class="text-xl font-semibold leading-tight tracking-[-0.02em] text-primary">{title}</h3>

    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag: string) => (
        <span class="rounded-full border border-accent/18 bg-accent/8 px-2.5 py-1 text-xs font-medium text-accent">{tag}</span>
      ))}
    </div>

    <div class="flex-1 text-sm leading-relaxed text-text-muted">
      <slot />
    </div>

    {metrics && (
      <div class="rounded-xl border border-primary/10 bg-secondary/35 p-3 text-sm font-semibold text-primary">
        {metrics}
      </div>
    )}

    {tools && tools.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-1.5 border-t border-primary/10 pt-3">
        {tools.map((tool: string) => (
          <span class="rounded-full bg-secondary/55 px-2.5 py-1 text-xs font-medium text-text-muted">{tool}</span>
        ))}
      </div>
    )}

    {figmaEmbedUrl && (
      <div class="mt-3 flex flex-col gap-2">
        <div class="exp-figma-frame"
             style="position:relative;width:390px;max-width:100%;margin:0 auto;aspect-ratio:360/644;background:var(--surface);border-radius:42px;overflow:hidden;border:7px solid #211d19;box-shadow:var(--shadow-lift);">
          <iframe
            src={figmaEmbedUrl}
            allowfullscreen loading="lazy" title={`${title} — Figma Prototype`}
            style="position:absolute;inset:0;width:100%;height:100%;border:none;z-index:2;border-radius:39px;background:transparent;transform:scale(1.10);transform-origin:center;"></iframe>
        </div>
      </div>
    )}

    {safeExternalUrl && (
      <a
        href={safeExternalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex items-center gap-1.5 rounded-full text-sm font-semibold text-accent transition-[color,transform] hover:text-primary active:scale-[0.97] focus:outline-none focus:ring-2 focus:ring-accent"
      >
        View Project
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
        </svg>
      </a>
    )}
  </div>
</article>

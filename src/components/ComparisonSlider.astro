---
import type { CreativeWorkItem } from '../data/creativeWorks';
import { getResponsiveImageSources } from '../utils/responsiveImage';

interface Props {
  item: CreativeWorkItem;
}

const { item } = Astro.props;
const { title, beforeImage, afterImage, beforeAlt, afterAlt } = item;
const beforeSources = getResponsiveImageSources(beforeImage, 960, 640);
const afterSources = getResponsiveImageSources(afterImage, 960, 640);
---

<div class="group overflow-hidden rounded-2xl border border-primary/10 bg-[var(--surface)] shadow-[var(--shadow-soft)] transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-[var(--shadow-lift)]">
  <img-comparison-slider
    value="50"
    aria-label={`Before and after image comparison: ${title}`}
    role="slider"
    tabindex="0"
  >
    <picture slot="before">
      {afterSources.webpSrcset && <source type="image/webp" srcset={afterSources.webpSrcset} sizes="(min-width: 768px) 50vw, 100vw" />}
      {afterSources.jpegSrcset && <source type="image/jpeg" srcset={afterSources.jpegSrcset} sizes="(min-width: 768px) 50vw, 100vw" />}
      <img src={afterSources.src} alt={afterAlt} class="h-auto w-full" loading="lazy" decoding="async" width={afterSources.width} height={afterSources.height} />
    </picture>
    <span slot="before-label" class="absolute left-3 top-3 rounded-full bg-primary/88 px-2.5 py-1 text-xs font-semibold text-background shadow-sm backdrop-blur-sm">AFTER</span>
    <picture slot="after">
      {beforeSources.webpSrcset && <source type="image/webp" srcset={beforeSources.webpSrcset} sizes="(min-width: 768px) 50vw, 100vw" />}
      {beforeSources.jpegSrcset && <source type="image/jpeg" srcset={beforeSources.jpegSrcset} sizes="(min-width: 768px) 50vw, 100vw" />}
      <img src={beforeSources.src} alt={beforeAlt} class="h-auto w-full" loading="lazy" decoding="async" width={beforeSources.width} height={beforeSources.height} />
    </picture>
    <span slot="after-label" class="absolute right-3 top-3 rounded-full border border-primary/10 bg-background/88 px-2.5 py-1 text-xs font-semibold text-primary shadow-sm backdrop-blur-sm">BEFORE</span>
  </img-comparison-slider>
  <div class="border-t border-primary/10 bg-background/70 p-4 text-left">
    <h3 class="text-sm font-semibold text-primary">{title}</h3>
  </div>
</div>

---
import type { CreativeWorkItem } from '../data/creativeWorks';
import { imagePath } from '../utils/image';

interface Props {
  item: CreativeWorkItem;
}

const { item } = Astro.props;
const { title, beforeImage, afterImage, beforeAlt, afterAlt } = item;
---

<div class="rounded-2xl overflow-hidden shadow-[0_1px_3px_rgb(0,0,0,0.04),0_4px_12px_rgb(0,0,0,0.03)]">
  <img-comparison-slider
    value="50"
    aria-label={`Before and after image comparison: ${title}`}
    role="slider"
    tabindex="0"
  >
    <img slot="before" src={imagePath(beforeImage)} alt={beforeAlt} class="w-full h-auto" loading="lazy" />
    <span slot="before-label" class="absolute top-3 left-3 bg-background/90 backdrop-blur-sm text-text-primary text-xs font-semibold px-2.5 py-1 rounded-md shadow-sm">BEFORE</span>
    <img slot="after" src={imagePath(afterImage)} alt={afterAlt} class="w-full h-auto" loading="lazy" />
    <span slot="after-label" class="absolute top-3 right-3 bg-accent/90 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-sm">AFTER</span>
  </img-comparison-slider>
  <div class="p-3.5 text-center bg-background">
    <h3 class="text-sm font-semibold text-text-primary">{title}</h3>
  </div>
</div>

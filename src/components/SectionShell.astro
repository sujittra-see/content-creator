---
export interface Props {
  id: string;
  className?: string;
}

const { id, className = '' } = Astro.props;
---

<section id={id} class={`relative overflow-hidden ${className}`}>
  <div class="mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 md:py-24 lg:px-8 lg:py-32">
    <slot />
  </div>
</section>

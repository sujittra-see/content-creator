---
import type { ImageGalleryItem } from '../data/activities';
import { imagePath } from '../utils/image';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  items: ImageGalleryItem[];
  aspectClass?: string;
}

const { items, aspectClass = 'aspect-[4/3]' } = Astro.props;
---

<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5 lg:items-start">
  {items.map((item, i) => (
    <figure
      class={`group cursor-pointer opacity-0 animate-fade-up ${i % 2 === 1 ? 'lg:mt-10' : ''} ${i === 2 ? 'lg:mt-20' : ''}`}
      style={`animation-delay: ${i * 70}ms`}
      data-lightbox-trigger
      data-image={imagePath(item.image)}
      data-alt={item.alt}
      data-title={item.title}
      tabindex="0"
    >
      <div class={`overflow-hidden rounded-2xl border border-primary/10 bg-[var(--surface)] ${aspectClass} shadow-[var(--shadow-soft)] transition-[transform,box-shadow] duration-300 ease-out group-hover:-translate-y-1 group-hover:shadow-[var(--shadow-lift)]`}>
        <ResponsiveImage
          src={item.image}
          alt={item.alt}
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.045]"
          width={320}
          height={240}
          sizes="(min-width: 1024px) 20vw, (min-width: 640px) 33vw, 50vw"
        />
      </div>
      <figcaption class="mt-3 text-left text-sm font-medium text-primary">
        {item.title}
        {item.year && <span class="block text-xs font-medium text-text-muted">{item.year}</span>}
      </figcaption>
    </figure>
  ))}
</div>

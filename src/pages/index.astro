---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SectionShell from '../components/SectionShell.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import ImageGrid from '../components/ImageGrid.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import ComparisonSlider from '../components/ComparisonSlider.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { navigation } from '../data/navigation';
import { skills } from '../data/skills';
import { Icon } from 'astro-icon/components';
import { skillIconMap } from '../data/skillIcons';
import { activities } from '../data/activities';
import { creativeWorks } from '../data/creativeWorks';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';
import { imagePath } from '../utils/image';
import { sanitizeHttpsUrl } from '../utils/url';

const experiences = await getCollection('experiences', ({ data }) => data.category === 'professional');
const academicProjects = await getCollection('experiences', ({ data }) => data.category === 'academic');
const certificates = await getCollection('certificates');

experiences.sort((a, b) => a.data.order - b.data.order);
academicProjects.sort((a, b) => a.data.order - b.data.order);

const safeResumeUrl = sanitizeHttpsUrl(profile.resumeUrl);
const showResume = Boolean(safeResumeUrl);
const showEmail = profile.email !== '##PLACEHOLDER##';
const showPhone = profile.phone !== '##PLACEHOLDER##';
---

<BaseLayout
  title="Eve | HR Content Creator & UX/UI Designer"
  description="Portfolio of Eve, a fourth-year Information Science student specializing in HR Content Creation, UX/UI Design, and Visual Storytelling."
  ogImage={imagePath("/images/IMG_2598-Photoroom-1.jpg")}
>

  <Header items={navigation} />

  <main>
    <!-- Section 1: Hero -->
    <section id="hero" class="relative flex min-h-[100dvh] items-end overflow-hidden bg-background pt-24 sm:pt-28">
      <div class="absolute inset-x-0 top-0 h-px bg-primary/10" aria-hidden="true"></div>
      <div class="absolute right-[-12rem] top-[-10rem] h-[34rem] w-[34rem] rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>

      <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 gap-8 px-4 pb-8 sm:gap-10 sm:px-6 sm:pb-10 lg:grid-cols-12 lg:items-end lg:px-8 lg:pb-14">
        <div class="order-2 min-w-0 lg:order-1 lg:col-span-7 lg:pb-10">
          <p class="eyebrow mb-4 max-w-full break-words sm:mb-5">Human Resources Content Creator</p>
          <h1 class="max-w-4xl break-words text-[clamp(2.85rem,14vw,8.25rem)] font-semibold leading-[0.84] text-primary sm:text-[clamp(3.4rem,11vw,8.25rem)] sm:leading-[0.82]">
            Eve<br />
            <span class="text-accent">Sujittra</span>
          </h1>
          <div class="mt-6 max-w-full border-l border-primary/18 pl-4 sm:mt-8 sm:max-w-2xl sm:pl-5">
            <p class="text-lg leading-relaxed text-primary sm:text-2xl">
              A visual storyteller shaping HR content, digital experiences, and campus projects with a careful eye for people, clarity, and craft.
            </p>
            <p class="mt-4 text-sm font-medium leading-relaxed text-text-muted sm:text-base">
              {profile.title} · {profile.institution}
            </p>
          </div>

          <div class="mt-7 flex w-full min-w-0 flex-col gap-3 sm:mt-8 sm:w-auto sm:flex-row">
            <a href="#experience" class="editorial-button w-full sm:w-auto">
              View selected work
              <Icon name="lucide:arrow-down" class="h-4 w-4" aria-hidden="true" />
            </a>
            {showResume ? (
              <a href={safeResumeUrl} target="_blank" rel="noopener noreferrer" class="editorial-link w-full sm:w-auto">
                Resume
                <Icon name="lucide:download" class="h-4 w-4" aria-hidden="true" />
              </a>
            ) : (
              <span class="editorial-link w-full cursor-not-allowed opacity-45 sm:w-auto">Resume coming soon</span>
            )}
          </div>
        </div>

        <div class="order-1 min-w-0 lg:order-2 lg:col-span-5">
          <div class="relative mx-auto w-full max-w-[min(17rem,calc(100vw-4rem))] sm:max-w-sm lg:ml-auto lg:max-w-md">
            <div class="absolute -left-8 top-10 hidden h-48 w-32 border border-primary/15 lg:block" aria-hidden="true"></div>
            <ResponsiveImage
              src="/images/IMG_2598-Photoroom-1.jpg"
              alt="Portrait of Sujittra Seelabut"
              class="relative aspect-[4/5] w-full rounded-[1.5rem] border border-primary/10 object-cover shadow-[var(--shadow-lift)] sm:rounded-[1.75rem]"
              width={520}
              height={650}
              sizes="(min-width: 1024px) 420px, 88vw"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute -bottom-5 left-2 right-2 rounded-2xl border border-background/70 bg-[var(--surface-strong)]/88 p-3 shadow-[0_24px_70px_-46px_rgba(39,33,28,0.85)] backdrop-blur-md sm:left-5 sm:right-5 sm:p-4">
              <p class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-accent sm:text-xs sm:tracking-[0.18em]">Based in {profile.location}</p>
              <p class="mt-1 text-sm font-medium leading-snug text-primary">Designing content that feels considered before it feels loud.</p>
            </div>
          </div>
        </div>

        <div class="order-3 border-t border-primary/12 pt-5 lg:col-span-12">
          <a href="#about" class="group inline-flex items-center gap-3 text-sm font-semibold text-text-muted transition-colors hover:text-accent">
            <span class="h-px w-10 bg-current transition-transform group-hover:translate-x-1"></span>
            Continue to profile
          </a>
        </div>
      </div>
    </section>

    <!-- Section 2: About Me -->
    <SectionShell id="about">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="relative lg:col-span-5">
          <div class="absolute -left-5 top-8 h-28 w-28 border border-accent/25" aria-hidden="true"></div>
          <ResponsiveImage
            src="/images/IMG_2598-Photoroom-1.jpg"
            alt="Sujittra Seelabut profile photo"
            class="relative mx-auto aspect-[4/5] w-full max-w-sm rounded-2xl border border-primary/10 object-cover shadow-[var(--shadow-soft)] lg:mx-0"
            width={460}
            height={575}
            sizes="(min-width: 1024px) 400px, 90vw"
          />
        </div>
        <div class="lg:col-span-7">
          <p class="eyebrow mb-4">Profile</p>
          <h2 class="max-w-3xl text-4xl font-semibold leading-[0.95] text-primary sm:text-5xl lg:text-6xl">
            Content with a human sense of timing.
          </h2>
          <p class="mt-8 max-w-2xl text-lg leading-relaxed text-primary">
            I am a fourth-year Information Science student at Khon Kaen University with a passion for creating meaningful visual content. My journey combines academic knowledge with hands-on experience in graphic design, video production, and digital content strategy.
          </p>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-text-muted">
            Through various roles in university organizations and projects, I have developed skills in visual storytelling, audience understanding, and data-informed decision making. I believe that great content connects people with purpose, and I strive to bring this philosophy to every project I undertake.
          </p>

          <ul class="mt-10 grid gap-6 border-t border-primary/12 pt-8 sm:grid-cols-3">
            <li class="group">
              <span class="block text-sm font-semibold text-accent">01</span>
              <div>
                <span class="mt-2 block text-base font-semibold text-primary">Visual Storytelling</span>
                <p class="mt-2 text-sm leading-relaxed text-text-muted">Crafting compelling narratives through design, photography, and video</p>
              </div>
            </li>
            <li class="group">
              <span class="block text-sm font-semibold text-accent">02</span>
              <div>
                <span class="mt-2 block text-base font-semibold text-primary">Audience Understanding</span>
                <p class="mt-2 text-sm leading-relaxed text-text-muted">Researching and connecting with target audiences effectively</p>
              </div>
            </li>
            <li class="group">
              <span class="block text-sm font-semibold text-accent">03</span>
              <div>
                <span class="mt-2 block text-base font-semibold text-primary">Data-Informed Decisions</span>
                <p class="mt-2 text-sm leading-relaxed text-text-muted">Using analytics and metrics to guide content strategy</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </SectionShell>

    <!-- Section 3: Skills & Expertise -->
    <SectionShell id="skills" className="bg-slate-50/70">
      <div class="mb-12 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-4">Practice</p>
          <h2 class="text-4xl font-semibold leading-none text-primary sm:text-5xl lg:text-6xl">Skills &amp; expertise</h2>
        </div>
        <p class="max-w-xl text-base leading-relaxed text-text-muted lg:col-span-5">
          Tools and capabilities developed through coursework, projects, and hands-on content production.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-12">
        {skills.map((skill, i) => (
          <div
            class={`flex flex-col gap-4 rounded-2xl border border-primary/10 bg-[var(--surface)]/78 p-6 opacity-0 shadow-[var(--shadow-soft)] transition-[transform,box-shadow] duration-300 ease-out animate-fade-up hover:-translate-y-1 hover:shadow-[var(--shadow-lift)] ${i === 0 || i === 2 ? 'lg:col-span-5' : 'lg:col-span-4'} ${i === 4 ? 'lg:col-span-4' : ''}`}
            style={`animation-delay: ${i * 75}ms`}
          >
            <div class="flex h-11 w-11 items-center justify-center rounded-full border border-accent/18 bg-accent/8 text-accent">
              <Icon name={skillIconMap[skill.icon] || 'lucide:pen-tool'} class="h-10 w-10" />
            </div>
            <h3 class="text-xl font-semibold tracking-[-0.02em] text-primary">{skill.title}</h3>
            <p class="text-sm leading-relaxed text-text-muted">{skill.description}</p>
          </div>
        ))}
      </div>
    </SectionShell>

    <!-- Section 4: Experience -->
    <SectionShell id="experience">
      <div class="mb-14 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-4">Selected work</p>
          <h2 class="text-4xl font-semibold leading-none text-primary sm:text-5xl lg:text-6xl">Experience</h2>
        </div>
        <p class="max-w-xl text-base leading-relaxed text-text-muted lg:col-span-5">
          A compact record of professional content work, academic UX projects, and the tools used to move ideas into public-facing form.
        </p>
      </div>

      <div class="mb-18">
        <div class="mb-8 flex items-center gap-4">
          <span class="h-px w-12 bg-accent" aria-hidden="true"></span>
          <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Professional Experience</h3>
        </div>
        <div class="grid grid-cols-1 gap-7 md:grid-cols-2 lg:grid-cols-3">
          {experiences.map((entry) => (
            <ExperienceCard entry={entry.data}>
              <Fragment set:html={entry.body} />
            </ExperienceCard>
          ))}
        </div>
      </div>

      <div>
        <div class="mb-8 flex items-center gap-4">
          <span class="h-px w-12 bg-primary/20" aria-hidden="true"></span>
          <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-text-muted">Academic Project</h3>
        </div>
        <div class="grid max-w-5xl grid-cols-1 gap-7 lg:grid-cols-2">
          {academicProjects.map((entry) => (
            <ExperienceCard entry={entry.data}>
              <Fragment set:html={entry.body} />
            </ExperienceCard>
          ))}
        </div>
      </div>
    </SectionShell>

    <!-- Section 5: Recognitions & Certificates -->
    <SectionShell id="certificates" className="bg-background">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <p class="cert-section-label">Certificates</p>
        <h2 class="text-4xl font-semibold leading-none text-primary sm:text-5xl lg:text-6xl">
          Recognitions &amp;<br class="block sm:hidden" /> <em class="font-playfair text-accent">Certificates</em>
        </h2>
      </div>

      <div class="cert-grid">
        {certificates.map((c, i) => (
          <figure
            class="cert-card group cursor-pointer opacity-0 animate-fade-up focus-within:ring-2 focus-within:ring-accent"
            style={`animation-delay: ${(i + 1) * 80}ms`}
            data-lightbox-trigger
            data-image={imagePath(c.data.image)}
            data-alt={`${c.data.title} certificate from ${c.data.issuer}`}
            data-title={`${c.data.title} · ${c.data.issuer}`}
          >
            <div class="cert-image">
              <ResponsiveImage
                src={c.data.image}
                alt={`${c.data.title} certificate from ${c.data.issuer}`}
                class="w-full h-full object-contain"
                width={400}
                height={300}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              />
            </div>
            <figcaption class="cert-content">
              <h4 class="cert-title">{c.data.title}</h4>
              <p class="cert-meta">{c.data.issuer} · {c.data.date}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </SectionShell>

    <!-- Section 6: Activities & Involvement -->
    <SectionShell id="activities">
      <div class="mb-12 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-4">Campus life</p>
          <h2 class="text-4xl font-semibold leading-none text-primary sm:text-5xl lg:text-6xl">Activities &amp; involvement</h2>
        </div>
        <p class="max-w-xl text-base leading-relaxed text-text-muted lg:col-span-5">
          Campus engagement and extracurricular projects beyond the classroom.
        </p>
      </div>
      <ImageGrid items={activities} aspectClass="aspect-[16/10]" />
    </SectionShell>

    <!-- Section 7: Creative Works -->
    <SectionShell id="works" className="bg-slate-50">
      <div class="mb-12 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-4">Before / after</p>
          <h2 class="text-4xl font-semibold leading-none text-primary sm:text-5xl lg:text-6xl">Creative works</h2>
        </div>
        <p class="max-w-xl text-base leading-relaxed text-text-muted lg:col-span-5">
          Before and after photo editing. Drag each slider to inspect tone, recovery, and color treatment.
        </p>
      </div>
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-7 md:grid-cols-4">
        {creativeWorks.map((work) => (
          <ComparisonSlider item={work} />
        ))}
      </div>
    </SectionShell>

    <!-- Section 8: Closing & Contact -->
    <section id="contact" class="relative overflow-hidden bg-primary text-background">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_10%,rgba(154,106,69,0.42),transparent_28rem)] pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 gap-12 px-4 py-20 sm:px-6 md:py-24 lg:grid-cols-12 lg:px-8 lg:py-32">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-5 text-background/62">Closing note</p>
          <blockquote class="max-w-4xl font-playfair text-4xl italic leading-[1.02] text-background sm:text-5xl lg:text-7xl">
            Every experience holds value.
          </blockquote>
          <p class="mt-6 text-base font-medium text-background/58">
            Sujittra Seelabut · Eve
          </p>
        </div>

        <div class="lg:col-span-5 lg:self-end">
          <h2 class="text-2xl font-semibold text-background sm:text-3xl">Let's connect</h2>

        <div class="mt-8 space-y-3">
          {showEmail && (
            <div class="flex items-center gap-3 text-background/64 transition-colors duration-200 hover:text-background">
              <Icon name="lucide:mail" class="h-[18px] w-[18px]" aria-hidden="true" />
              <a href={`mailto:${profile.email}`} class="font-medium">{profile.email}</a>
            </div>
          )}
          {showPhone && (
            <div class="flex items-center gap-3 text-background/64 transition-colors duration-200 hover:text-background">
              <Icon name="lucide:phone" class="h-[18px] w-[18px]" aria-hidden="true" />
              <a href={`tel:${profile.phone}`} class="font-medium">{profile.phone}</a>
            </div>
          )}
          <div class="flex items-center gap-3 text-background/64">
            <Icon name="lucide:map-pin" class="h-[18px] w-[18px]" aria-hidden="true" />
            <span class="font-medium">{profile.location}</span>
          </div>
        </div>

        {showResume ? (
          <a
            href={safeResumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-10 inline-flex items-center gap-2 rounded-full border border-background/30 px-5 py-3 text-sm font-semibold text-background transition-[background-color,border-color,transform] hover:border-background/55 hover:bg-background/10 active:scale-[0.97] focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-primary"
          >
            Download Resume
            <Icon name="lucide:download" class="h-4 w-4" aria-hidden="true" />
          </a>
        ) : (
          <span class="mt-10 inline-flex cursor-not-allowed items-center gap-2 rounded-full border border-background/15 px-5 py-3 text-sm font-medium text-background/30">
            Resume Link Coming Soon
          </span>
        )}

        <footer class="mt-16 border-t border-background/10 pt-6 text-sm text-background/42">
          <p>&copy; 2026 Sujittra Seelabut. All rights reserved.</p>
        </footer>
        </div>
      </div>
    </section>
  </main>

  <ImageLightbox />

  <script>
    import 'img-comparison-slider';
  </script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SectionShell from '../components/SectionShell.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import ImageGrid from '../components/ImageGrid.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import ComparisonSlider from '../components/ComparisonSlider.astro';
import { navigation } from '../data/navigation';
import { skills } from '../data/skills';
import { activities } from '../data/activities';
import { creativeWorks } from '../data/creativeWorks';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';
import { imagePath } from '../utils/image';

const experiences = await getCollection('experiences', ({ data }) => data.category === 'professional');
const academicProjects = await getCollection('experiences', ({ data }) => data.category === 'academic');
const certificates = await getCollection('certificates');

experiences.sort((a, b) => a.data.order - b.data.order);
academicProjects.sort((a, b) => a.data.order - b.data.order);

const showResume = profile.resumeUrl !== '##PLACEHOLDER##';
const showEmail = profile.email !== '##PLACEHOLDER##';
const showPhone = profile.phone !== '##PLACEHOLDER##';

const certificateGalleryItems = certificates.map((c) => ({
  title: c.data.title,
  year: c.data.date,
  image: c.data.image,
  alt: `${c.data.title} certificate from ${c.data.issuer}`,
}));

const iconSvg: Record<string, string> = {
  camera: '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#1E3A5F" stroke-width="1.5" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>',
  sliders: '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#1E3A5F" stroke-width="1.5" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>',
  layers: '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#1E3A5F" stroke-width="1.5" aria-hidden="true"><polygon points="12 2 22 8.5 12 15 2 8.5 12 2"/><polyline points="2 15.5 12 22 22 15.5"/></svg>',
  'bar-chart': '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#1E3A5F" stroke-width="1.5" aria-hidden="true"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>',
  'pen-tool': '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#1E3A5F" stroke-width="1.5" aria-hidden="true"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>',
};
---

<BaseLayout
  title="Eve | HR Content Creator & UX/UI Designer"
  description="Portfolio of Eve, a fourth-year Information Science student specializing in HR Content Creation, UX/UI Design, and Visual Storytelling."
  ogImage={imagePath("/images/IMG_2598-Photoroom-1.jpg")}
>

  <Header items={navigation} />

  <main class="snap-y snap-mandatory overflow-y-scroll h-dvh">
    <!-- Section 1: Hero -->
    <section id="hero" class="min-h-dvh snap-start flex items-center bg-background relative overflow-hidden">
      <!-- Ambient background accent -->
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-accent/3 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4 pointer-events-none" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-primary/2 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4 pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20 lg:py-24 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-7 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/8 text-accent text-xs font-semibold tracking-wide uppercase mb-6">
              <span class="w-2 h-2 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
              Aspiring HR Content Creator
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold leading-none mb-6">
              Hello, I'm<br class="hidden sm:block" /> <span class="text-primary">Eve</span>
            </h1>
            <p class="text-xl lg:text-2xl text-text-muted mb-1">
              Sujittra Seelabut
            </p>
            <p class="text-base lg:text-lg text-text-primary mb-1">
              Fourth-year Student in Bachelor of Information Science
            </p>
            <p class="text-sm lg:text-base text-text-muted mb-8">
              Faculty of Humanities and Social Sciences, Khon Kaen University (KKU)
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a
                href="#experience"
                class="inline-flex items-center gap-2 bg-primary text-white font-semibold px-6 py-3 rounded-lg hover:bg-primary/90 active:scale-[0.97] transition-transform duration-150 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
              >
                See What I've Built
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M12 5v14M19 12l-7 7-7-7" />
                </svg>
              </a>
              {showResume ? (
                <a
                  href={profile.resumeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 border-2 border-primary/20 text-primary font-semibold px-6 py-3 rounded-lg hover:border-primary/40 hover:bg-primary/3 active:scale-[0.97] transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
                >
                  Download Resume
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
                  </svg>
                </a>
              ) : (
                <span class="inline-flex items-center gap-2 border-2 border-primary/20 text-primary/30 font-medium px-6 py-3 rounded-lg cursor-not-allowed">
                  Resume Link Coming Soon
                </span>
              )}
            </div>
          </div>
          <div class="lg:col-span-5 flex justify-center lg:justify-end">
            <div class="relative">
              <div class="absolute -inset-4 bg-accent/5 rounded-[2rem] blur-xl" aria-hidden="true"></div>
              <img
                src={imagePath("/images/IMG_2598-Photoroom-1.jpg")}
                alt="Portrait of Sujittra Seelabut"
                class="relative w-56 h-72 sm:w-64 sm:h-80 lg:w-80 lg:h-96 object-cover rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.06)]"
                width="320"
                height="400"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: About Me -->
    <SectionShell id="about">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-5 relative">
          <div class="absolute -top-6 -left-6 w-32 h-32 border-2 border-accent/20 rounded-2xl -z-10" aria-hidden="true"></div>
          <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-accent/5 rounded-2xl -z-10" aria-hidden="true"></div>
          <img
            src={imagePath("/images/IMG_2598-Photoroom-1.jpg")}
            alt="Sujittra Seelabut profile photo"
            class="w-full max-w-sm mx-auto lg:mx-0 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.06)] object-cover"
            loading="lazy"
            width="400"
            height="500"
          />
        </div>
        <div class="lg:col-span-7">
          <h2 class="text-3xl lg:text-5xl font-bold mb-8">About Me</h2>
          <p class="text-lg leading-relaxed mb-5">
            I am a fourth-year Information Science student at Khon Kaen University with a passion for creating meaningful visual content. My journey combines academic knowledge with hands-on experience in graphic design, video production, and digital content strategy.
          </p>
          <p class="text-base text-text-muted leading-relaxed mb-8">
            Through various roles in university organizations and projects, I have developed skills in visual storytelling, audience understanding, and data-informed decision making. I believe that great content connects people with purpose, and I strive to bring this philosophy to every project I undertake.
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-4 group">
              <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-accent/10 text-accent flex items-center justify-center text-sm font-bold group-hover:scale-110 transition-transform duration-200">1</span>
              <div>
                <span class="text-base font-semibold">Visual Storytelling</span>
                <p class="text-sm text-text-muted mt-0.5">Crafting compelling narratives through design, photography, and video</p>
              </div>
            </li>
            <li class="flex items-start gap-4 group">
              <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-accent/10 text-accent flex items-center justify-center text-sm font-bold group-hover:scale-110 transition-transform duration-200">2</span>
              <div>
                <span class="text-base font-semibold">Audience Understanding</span>
                <p class="text-sm text-text-muted mt-0.5">Researching and connecting with target audiences effectively</p>
              </div>
            </li>
            <li class="flex items-start gap-4 group">
              <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-accent/10 text-accent flex items-center justify-center text-sm font-bold group-hover:scale-110 transition-transform duration-200">3</span>
              <div>
                <span class="text-base font-semibold">Data-Informed Decisions</span>
                <p class="text-sm text-text-muted mt-0.5">Using analytics and metrics to guide content strategy</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </SectionShell>

    <!-- Section 3: Skills & Expertise -->
    <SectionShell id="skills" className="bg-slate-50">
      <h2 class="text-3xl lg:text-5xl font-bold mb-4 text-center">Skills &amp; Expertise</h2>
      <p class="text-text-muted text-center mb-12 max-w-lg mx-auto">Tools and capabilities I've developed through coursework, projects, and hands-on experience</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
        {skills.map((skill, i) => (
          <div
            class="bg-white rounded-2xl shadow-[0_1px_3px_rgb(0,0,0,0.04),0_4px_12px_rgb(0,0,0,0.03)] p-6 flex flex-col gap-3 hover:shadow-[0_1px_3px_rgb(0,0,0,0.06),0_8px_24px_rgb(0,0,0,0.04)] hover:-translate-y-0.5 transition-all duration-300 opacity-0 animate-fade-up"
            style={`animation-delay: ${i * 80}ms`}
          >
            <div class="w-10 h-10 rounded-xl bg-accent/8 flex items-center justify-center">
              <Fragment set:html={iconSvg[skill.icon] || iconSvg['pen-tool']} />
            </div>
            <h3 class="text-lg font-semibold">{skill.title}</h3>
            <p class="text-sm text-text-muted leading-relaxed">{skill.description}</p>
          </div>
        ))}
      </div>
    </SectionShell>

    <!-- Section 4: Experience -->
    <SectionShell id="experience">
      <h2 class="text-3xl lg:text-5xl font-bold mb-16 text-center">Experience</h2>

      <div class="mb-16">
        <div class="flex items-center gap-4 mb-8">
          <span class="w-8 h-0.5 bg-accent rounded-full" aria-hidden="true"></span>
          <h3 class="text-lg font-semibold text-primary tracking-wide uppercase">Professional Experience</h3>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {experiences.map((entry) => (
            <ExperienceCard entry={entry.data}>
              <Fragment set:html={entry.body} />
            </ExperienceCard>
          ))}
        </div>
      </div>

      <div>
        <div class="flex items-center gap-4 mb-8">
          <span class="w-8 h-0.5 bg-accent/50 rounded-full" aria-hidden="true"></span>
          <h3 class="text-lg font-semibold text-text-muted tracking-wide uppercase">Academic Project</h3>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-4xl">
          {academicProjects.map((entry) => (
            <ExperienceCard entry={entry.data}>
              <Fragment set:html={entry.body} />
            </ExperienceCard>
          ))}
        </div>
      </div>
    </SectionShell>

    <!-- Section 5: Recognitions & Certificates -->
    <SectionShell id="certificates" className="bg-slate-50">
      <h2 class="text-3xl lg:text-5xl font-bold mb-4 text-center">Recognitions &amp; Certificates</h2>
      <p class="text-text-muted text-center mb-12 max-w-lg mx-auto">Professional certifications and achievements that validate my expertise</p>
      <ImageGrid
        items={certificateGalleryItems}
        aspectClass="aspect-[4/3]"
      />
    </SectionShell>

    <!-- Section 6: Activities & Involvement -->
    <SectionShell id="activities">
      <h2 class="text-3xl lg:text-5xl font-bold mb-4 text-center">Activities &amp; Involvement</h2>
      <p class="text-text-muted text-center mb-12 max-w-lg mx-auto">Campus engagement and extracurricular projects beyond the classroom</p>
      <ImageGrid items={activities} aspectClass="aspect-[16/10]" />
    </SectionShell>

    <!-- Section 7: Creative Works -->
    <SectionShell id="works" className="bg-slate-50">
      <h2 class="text-3xl lg:text-5xl font-bold mb-4 text-center">Creative Works</h2>
      <p class="text-text-muted text-center mb-12 max-w-lg mx-auto">Before and after photo editing — drag the slider to see the transformation</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {creativeWorks.map((work) => (
          <ComparisonSlider item={work} />
        ))}
      </div>
    </SectionShell>

    <!-- Section 8: Closing & Contact -->
    <section id="contact" class="min-h-[80dvh] snap-start flex items-center bg-primary relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-accent/10 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20 lg:py-24 text-center relative z-10">
        <div class="mb-10">
          <p class="text-6xl lg:text-7xl text-accent/60 leading-none mb-4" aria-hidden="true">&ldquo;</p>
          <blockquote class="text-2xl lg:text-3xl italic font-bold mb-4 text-white">
            Every experience holds value.
          </blockquote>
          <p class="text-lg text-white/60">
            &mdash; Sujittra Seelabut &middot; Eve
          </p>
        </div>

        <hr class="border-white/10 mb-10 max-w-xs mx-auto" />

        <h2 class="text-2xl lg:text-3xl font-bold mb-8 text-white">Let's Connect</h2>

        <div class="space-y-3 mb-10">
          {showEmail && (
            <div class="flex items-center justify-center gap-3 text-white/60 hover:text-accent transition-colors duration-200">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <a href={`mailto:${profile.email}`} class="font-medium">{profile.email}</a>
            </div>
          )}
          {showPhone && (
            <div class="flex items-center justify-center gap-3 text-white/60 hover:text-accent transition-colors duration-200">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <a href={`tel:${profile.phone}`} class="font-medium">{profile.phone}</a>
            </div>
          )}
          <div class="flex items-center justify-center gap-3 text-white/60">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="font-medium">{profile.location}</span>
          </div>
        </div>

        {showResume ? (
          <a
            href={profile.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border-2 border-white/30 text-white font-semibold px-6 py-3 rounded-lg hover:bg-white/10 hover:border-white/50 active:scale-[0.97] transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-primary"
          >
            Download Resume
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
            </svg>
          </a>
        ) : (
          <span class="inline-flex items-center gap-2 border-2 border-white/15 text-white/30 font-medium px-6 py-3 rounded-lg cursor-not-allowed">
            Resume Link Coming Soon
          </span>
        )}

        <footer class="mt-16 text-sm text-white/40">
          <p>&copy; 2026 Sujittra Seelabut. All rights reserved.</p>
        </footer>
      </div>
    </section>
  </main>

  <ImageLightbox />

  <script>
    import 'img-comparison-slider';
  </script>
</BaseLayout>
